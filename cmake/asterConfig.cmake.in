@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Threads)
find_dependency(Qt@QT_VERSION_MAJOR@ COMPONENTS Core Gui)

if(@ASTER_PACKAGE_HAS_GUI@)
    find_dependency(Qt@QT_VERSION_MAJOR@ COMPONENTS Widgets)
endif()

if(@ASTER_PACKAGE_HAS_NETWORK@)
    find_dependency(Qt@QT_VERSION_MAJOR@ COMPONENTS Network)
endif()

if(@ASTER_PACKAGE_HAS_SQLITE@)
    find_dependency(Qt@QT_VERSION_MAJOR@ COMPONENTS Sql)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/asterTargets.cmake")

check_required_components(aster)
